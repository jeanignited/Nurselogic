<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="nurselogicPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.nurselogic.model.Rol</class>
        <class>com.nurselogic.model.Usuario</class>
        <class>com.nurselogic.model.Paciente</class>
        <class>com.nurselogic.model.Medicamento</class>
        <class>com.nurselogic.model.Especialidad</class>
        <class>com.nurselogic.model.Cita</class>
        <class>com.nurselogic.model.Enfermedad</class>
                <class>com.nurselogic.model.Alergia</class>
        <class>com.nurselogic.model.Factura</class>
        <class>com.nurselogic.model.FacturaDetalle</class>
        <class>com.nurselogic.model.Cama</class>

        <properties>

            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/nurselogic_db?useSSL=false&amp;serverTimezone=UTC"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>

            <property name="jakarta.persistence.jdbc.password" value="Tobbysql2006."/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>
    </persistence-unit>
</persistence>